{
  "manifest_version": 3,
  "name": "Oxy session share",
  "version": "1.0.0",
  "description": "Share one site's signed-in session with your Oxy agent.",
  "permissions": [
    "activeTab",
    "cookies",
    "storage"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "host_permissions": [
    "https://milgrain-live-2026.fly.dev/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}